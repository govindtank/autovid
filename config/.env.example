# AutoVid Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED - Get from these sources:
# ===========================================

# OpenAI API for LLM scene decomposition
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Pexels API for stock video download (FREE)
# Get at: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here

# ===========================================
# OPTIONAL
# ===========================================

# Pixabay API (alternative to Pexels)
# Get at: https://pixabay.com/api/
PIXABAY_API_KEY=

# HuggingFace Token for local models
HF_TOKEN=hf-your-huggingface-token-here

# Azure services (optional alternatives)
AZURE_ENDPOINT=https://your-tts-resource.azure-api.net
AZURE_TTS_KEY=your-azure-tts-key
AZURE_OPENAI_KEY=your-azure-openai-key

# ===========================================
# LOCAL DEVELOPMENT - Can be overridden in .env
# ===========================================

REDIS_HOST=localhost
REDIS_PORT=6379
